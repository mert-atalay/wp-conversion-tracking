<?xml version="1.0"?>
<ruleset name="Lead Conversion Tracking">
	<description>WordPress Coding Standards for the plugin code.</description>

	<file>lead-conversion-tracking.php</file>
	<file>uninstall.php</file>
	<file>src</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_wp_version" value="6.3"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress">
		<!-- Classes are autoloaded PSR-4 style from src/, one class per file named after the class. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- The lct_ prefix is three letters. WPCS prefers four or more. Kept short on purpose for an example plugin. -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals.ShortPrefixPassed"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="lead-conversion-tracking"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="lct"/>
				<element value="LCT"/>
			</property>
		</properties>
	</rule>
</ruleset>
